{
  "name": "@aichance/playwright-state-lens",
  "version": "0.7.0-experimental.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./lens.d.mts",
      "import": "./lens.mjs",
      "default": "./lens.mjs"
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:consumer": "playwright test",
    "demo": "node demo.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json && tsc -p tests/types/tsconfig-allowjs.json && node tests/types/single-file.mjs",
    "build:python": "node python/build.mjs",
    "test:python": "node python/build.mjs --check && python3 -B -m unittest discover -s python -p test_*.py"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.51 <2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "files": [
    "lens.mjs",
    "capture.mjs",
    "lens.d.mts",
    "demo.mjs",
    "demo",
    "tests",
    "examples",
    "playwright.config.mjs",
    "README.md",
    "LICENSE",
    "python/state_lens.py",
    "python/runtime.py",
    "python/build.mjs",
    "python/test_sync.py",
    "python/fixture.js",
    "python/fixture.html",
    "python/parity.mjs",
    "python/README.md"
  ],
  "license": "MIT",
  "types": "./lens.d.mts",
  "bin": {
    "state-lens-capture": "./capture.mjs"
  }
}
