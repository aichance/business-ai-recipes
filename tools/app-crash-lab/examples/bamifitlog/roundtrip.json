  ],
  "checks": [
    "backup-roundtrip"
  ],
  "backupRoundtrip": {
    "isolation": "browser-local",
    "export": {
      "steps": [
        {
          "action": "click",
          "target": {
            "css": "button[data-view=\"settings\"]"
          }
        },
        {
          "action": "click",
          "target": {
            "css": "button[data-act=\"export\"]"
          }
        }
      ],
      "maxBytes": 65536,
      "statePaths": {
        "database": []
      }
    },
    "restore": {
      "path": "/",
      "ready": [
        {
          "action": "expectVisible",
          "target": {
            "css": "#view"
          }
        }
      ],
      "empty": {
        "database": null,
        "renderedRoutine": 0
      },
      "target": {
        "css": "#importFile"
      },
      "mimeType": "application/json",
      "confirm": {
        "message": "Replace current data with the backup (1 sessions, 1 routines)?",
        "accept": true
      },
      "success": {
        "observe": {
          "status": {
            "source": "text",
            "target": {
              "css": "#toast"
            }
          }
        },
        "expected": {
          "status": "Backup restored"
        }
      }
    }
