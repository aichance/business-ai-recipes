    "profileLabel": 1,
    "visibleCorrection": 1,
    "visibleReference": 1
  },
  "checks": [
    "reload"
  ],
  "afterReload": [
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "System Improvement Log"
      }
    },
    {
      "action": "expectText",
      "target": {
        "css": "article.line:first-of-type h3"
      },
      "value": "Keep the prerequisite link after restore"
    }
  ]
}
