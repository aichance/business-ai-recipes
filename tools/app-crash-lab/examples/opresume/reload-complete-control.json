{
  "schemaVersion": 1,
  "pack": "state-preservation@1",
  "name": "OpResume / complete-control / complete saved resume reload",
  "baseURL": "http://127.0.0.1:54192",
  "path": "/editor.html?lng=en-US",
  "timeoutMs": 8000,
  "stabilityMs": 800,
  "reset": [],
  "setup": [
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Data"
      }
    },
    {
      "action": "click",
      "target": {
        "role": "menuitem",
        "name": "Clear Data"
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Confirm Clear"
      }
    },
    {
      "action": "expectVisible",
      "target": {
        "css": "[data-sonner-toast]:has-text(\"Data cleared\")"
      }
    },
    {
      "action": "setFile",
      "target": {
        "label": "Import JSON"
      },
      "file": {
        "name": "synthetic-complete.json",
        "mimeType": "application/json",
        "text": "{\"$schema\": \"https://raw.githubusercontent.com/jsonresume/resume-schema/master/schema.json\", \"basics\": {\"name\": \"Crash Lab Synthetic\", \"label\": \"Synthetic tester\", \"email\": \"nobody@example.invalid\", \"location\": {\"city\": \"Synthetic City\"}, \"summary\": \"Test fixture only — 日本語 42\"}, \"work\": [{\"name\": \"Synthetic Laboratory\", \"position\": \"Test engineer\", \"startDate\": \"2024-01-01\", \"endDate\": \"2025-01-01\", \"summary\": \"Synthetic work history\", \"highlights\": [\"Preserve every supplied field\"]}], \"education\": [], \"projects\": [], \"skills\": [{\"name\": \"Testing\", \"level\": \"Synthetic\", \"keywords\": [\"Playwright\", \"日本語\"]}], \"awards\": [], \"x-op-avatar\": {\"width\": 90, \"height\": 126, \"borderRadius\": 0, \"hidden\": true, \"src\": \"/api/avatar?t=1773238453169\"}, \"x-op-birthday\": \"2000-01-01\", \"x-op-ageHidden\": true, \"x-op-workExpYear\": \"1\", \"x-op-customFields\": [], \"x-op-aboutmeHtml\": \"<p>Synthetic applicant only.</p>\", \"opresumeVersion\": \"1.6.0\"}"
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Confirm Overwrite"
      },
      "save": true
    },
    {
      "action": "expectVisible",
      "target": {
        "css": "[data-sonner-toast]:has-text(\"Imported successfully\")"
      }
    }
  ],
  "afterReload": [
    {
      "action": "expectVisible",
      "target": {
        "role": "button",
        "name": "Data"
      }
    }
  ],
  "observe": {
    "resume": {
      "source": "localStorage",
      "key": "opresume-resumes",
      "parse": "json",
      "jsonPath": [
        "resumes",
        0,
        "data"
      ]
    },
    "workItems": {
      "source": "count",
      "target": {
        "css": "[data-module-key=\"workExpList\"] [data-item-index]"
      }
    }
  },
  "expected": {
    "resume": {
      "basics": {
        "name": "Crash Lab Synthetic",
        "label": "Synthetic tester",
        "email": "nobody@example.invalid",
        "location": {
          "city": "Synthetic City"
        },
        "summary": "Test fixture only — 日本語 42"
      },
      "$schema": "https://raw.githubusercontent.com/jsonresume/resume-schema/master/schema.json",
      "work": [
        {
          "name": "Synthetic Laboratory",
          "position": "Test engineer",
          "startDate": "2024-01-01",
          "endDate": "2025-01-01",
          "summary": "Synthetic work history",
          "highlights": [
            "Preserve every supplied field"
          ]
        }
      ],
      "education": [],
      "projects": [],
      "skills": [
        {
          "name": "Testing",
          "level": "Synthetic",
          "keywords": [
            "Playwright",
            "日本語"
          ]
        }
      ],
      "awards": [],
      "x-op-avatar": {
        "width": 90,
        "height": 126,
        "borderRadius": 0,
        "hidden": true,
        "src": "/api/avatar?t=1773238453169"
      },
      "x-op-birthday": "2000-01-01",
      "x-op-ageHidden": true,
      "x-op-workExpYear": "1",
      "x-op-customFields": [],
      "x-op-aboutmeHtml": "<p>Synthetic applicant only.</p>"
    },
    "workItems": 1
  },
  "checks": [
    "reload"
  ]
}
