{
  "schemaVersion": 1,
  "pack": "state-preservation@1",
  "name": "Augur demo / saved feedback survives reload",
  "baseURL": "http://127.0.0.1:5178",
  "path": "/",
  "timeoutMs": 5000,
  "stabilityMs": 250,
  "reset": [],
  "setup": [
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Give feedback"
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Something broke"
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "Something broke"
      },
      "value": "Crash Lab synthetic feedback 2212"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Send"
      },
      "save": true
    }
  ],
  "observe": {
    "noteBody": {
      "source": "localStorage",
      "key": "augur.local",
      "parse": "json",
      "jsonPath": [
        "notes",
        0,
        "body"
      ]
    },
    "category": {
      "source": "localStorage",
      "key": "augur.local",
      "parse": "json",
      "jsonPath": [
        "events",
        0,
        "category"
      ]
    },
    "outcome": {
      "source": "localStorage",
      "key": "augur.local",
      "parse": "json",
      "jsonPath": [
        "events",
        0,
        "outcome"
      ]
    }
  },
  "expected": {
    "noteBody": "Crash Lab synthetic feedback 2212",
    "category": "broke",
    "outcome": "answered"
  },
  "checks": [
    "reload"
  ]
}
